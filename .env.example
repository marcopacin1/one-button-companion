# Copy to .env and fill in. Never commit .env.

# "mock" serves generated sample data (no key needed). "live" reads the real game.
DATA_SOURCE=mock

# Open Cloud API key with READ-ONLY access to:
#   universe-datastores  -> read entries
#   ordered-data-stores  -> read entries
# scoped to the One Button experience only.
ROBLOX_API_KEY=

# One Button's universe id (game.GameId in Studio).
ROBLOX_UNIVERSE_ID=10200693154

PORT=3001
